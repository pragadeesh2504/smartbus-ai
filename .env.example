# ==============================================================================
# SmartBus AI — Environment Configuration Example (.env.example)
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL
# ==============================================================================

# Server & Database
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/smartbus
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME

# Security (JWT secret must be at least 256 bits / 32 bytes)
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTE_HEX_OR_RANDOM_SECRET_KEY
JWT_EXPIRATION=3600000

# CORS & WebSocket Allowed Origins (comma-separated, no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Logging
LOG_LEVEL=INFO
SMARTBUS_LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_GPS_MAX=60
RATE_LIMIT_GPS_WINDOW=60
RATE_LIMIT_EXPORT_MAX=10
RATE_LIMIT_EXPORT_WINDOW=60

# Frontend (Optional: leave blank when using same-origin or Nginx reverse proxy)
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
