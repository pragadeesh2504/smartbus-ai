# ==============================================================================
# SmartBus AI — Environment Configuration Template (.env.example)
# PRODUCTION (Render / Vercel / Neon) & LOCAL DEVELOPMENT CONFIGURATION
#
# IMPORTANT: DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (Render Web Service / Local Spring Boot)
# ------------------------------------------------------------------------------

# Server Port (Render automatically supplies $PORT, e.g. 10000; defaults to 8080 locally)
PORT=8080

# PostgreSQL Database (Neon Serverless PostgreSQL or local PostgreSQL)
# IMPORTANT: For Neon, use the DIRECT connection string (port 5432) so Flyway migrations work.
# Do NOT use the pooled PgBouncer connection (port 6543) for migration startup.
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_HOST>:5432/<NEON_DB>?sslmode=require
SPRING_DATASOURCE_USERNAME=<NEON_USER>
SPRING_DATASOURCE_PASSWORD=<NEON_PASSWORD>

# JWT Security (Must be at least 256 bits / 32 bytes; generate via: openssl rand -hex 32)
JWT_SECRET=<CHANGE_ME_GENERATE_32_BYTE_HEX_KEY>
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# CORS & WebSocket Allowed Origins (comma-separated, exact origins only, NO wildcards)
# Set this to your deployed Vercel domain:
CORS_ALLOWED_ORIGINS=https://<VERCEL_APP_DOMAIN>

# Canonical Frontend URL (used for password reset email links)
FRONTEND_URL=https://<VERCEL_APP_DOMAIN>

# Demo Data Seeder & Simulation Toggles (STRICTLY FALSE FOR PRODUCTION)
SEED_DEMO_DATA=false
SMARTBUS_SIMULATION_ENABLED=false

# JVM Memory & Container Flags (Crucial for Render Free Tier 512 MB RAM limit)
JAVA_OPTS=-XX:+UseContainerSupport -Xmx256m -Xms128m -XX:MaxMetaspaceSize=128m -Xss512k -Djava.security.egd=file:/dev/./urandom

# Application Logging Levels
LOG_LEVEL=INFO
SMARTBUS_LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_GPS_MAX=60
RATE_LIMIT_GPS_WINDOW=60
RATE_LIMIT_EXPORT_MAX=10
RATE_LIMIT_EXPORT_WINDOW=60


# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Vercel Project Settings / Local Vite)
# ------------------------------------------------------------------------------

# Backend REST API Base URL (Point to your live Render backend)
VITE_API_BASE_URL=https://<RENDER_BACKEND_DOMAIN>

# WebSocket Live Location Base URL (Point to your live Render backend using wss://)
VITE_WS_BASE_URL=wss://<RENDER_BACKEND_DOMAIN>

# Google Maps API Key (Optional: leave blank or omit to use built-in OpenStreetMap/Photon fallback)
# If provided, restrict to HTTP referrers: https://<VERCEL_APP_DOMAIN>/*
VITE_GOOGLE_MAPS_API_KEY=<OPTIONAL_RESTRICTED_GOOGLE_MAPS_API_KEY>
